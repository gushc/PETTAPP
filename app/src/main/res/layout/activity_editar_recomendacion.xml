<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="Editar Recomendación"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="25dp"
                android:layout_marginTop="20dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="25dp"
                android:backgroundTint="@color/white"
                app:cardElevation="4dp"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:text="Título"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>
                    <EditText
                        android:id="@+id/edtEditarTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/button_border"
                        android:padding="12dp"
                        android:inputType="textCapSentences"/>

                    <TextView
                        android:text="Descripción"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>
                    <EditText
                        android:id="@+id/edtEditarDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/button_border"
                        android:layout_marginTop="5dp"
                        android:padding="12dp"
                        android:gravity="top"
                        android:maxLines="4"
                        android:inputType="textMultiLine"/>

                    <TextView
                        android:text="Categoría"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"/>
                    <EditText
                        android:id="@+id/edtEditarCategoria"
                        android:layout_marginTop="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/button_border"
                        android:padding="12dp"
                        android:inputType="text"/>

                    <TextView
                        android:text="Imagen (Toca para cambiar)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>
                    <ImageView
                        android:id="@+id/imgEditarFoto"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="5dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/button_border"/>

                    <LinearLayout
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:text="Actualizar ubicación"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <Switch
                            android:id="@+id/switchEditarUbicacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMapaPreview"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">
                        <com.google.android.gms.maps.MapView
                            android:id="@+id/mapaPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            xmlns:map="http://schemas.android.com/apk/res-auto"
                            map:liteMode="true"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp">
                        <Button
                            android:id="@+id/btnCancelarEdicion"
                            android:layout_marginTop="10dp"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Cancelar"
                            android:backgroundTint="#757575"
                            android:textColor="@android:color/white"/>
                        <TextView
                            android:layout_width="20dp"
                            android:layout_height="match_parent"/>
                        <Button
                            android:id="@+id/btnActualizar"
                            android:layout_marginTop="10dp"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Actualizar"
                            android:backgroundTint="@color/colorbase"
                            android:textColor="@android:color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>