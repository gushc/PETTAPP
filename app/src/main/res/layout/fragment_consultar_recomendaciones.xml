<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".recomendaciones.ConsultarRecomendacionesFragment"
    android:background="@color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recomendaciones"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:src="@drawable/baseline_person_add_24"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical">

                <!-- LÍNEA SEPARADORA -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/colorbase" /> <!-- Aquí usa el color azul de tu app -->

                <!-- Tarjeta para agregar mascota -->
                <LinearLayout
                    android:id="@+id/btnAgregarRecomendacion"
                    android:layout_width="380dp"
                    android:layout_marginStart="15dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/button_border"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_marginTop="0dp"
                        android:layout_height="100dp"
                        android:background="@drawable/ic_agregar"
                        android:textColor="@color/white"
                        android:textSize="80sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/TxtAgregarRecomendacion"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="@color/colorbase" />

                </LinearLayout>

                <TextView
                    android:text="@string/TxtMisRecomendaciones"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gris"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="3dp"
                    android:paddingVertical="10dp">

                    <Button
                        android:id="@+id/btnVerMisRecomendaciones"
                        android:layout_marginTop="-5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:textSize="16sp"
                        android:text="@string/TxtVerMisRecomendaciones"
                        android:backgroundTint="@color/colorbase"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:text="@string/TxtOtrasRecomendaciones"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/gris"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Filtros: categoría y orden -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:layout_height="wrap_content">

                        <Spinner
                            android:id="@+id/spinnerCategoriaRecomendacion"
                            android:backgroundTint="@color/colorbase"
                            android:textColor="@color/white"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:background="@drawable/button_border"
                            android:layout_height="32dp"
                            />
                        <Spinner
                            android:id="@+id/spinnerOrdenRecomendacion"
                            android:backgroundTint="@color/colorbase"
                            android:textColor="@color/white"
                            android:background="@drawable/button_border"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"/>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvOtrasRecomendaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingBottom="10dp"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>