<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/notificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificaciones"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#EDE7F6"
            android:textColor="#673AB7"
            android:padding="20dp" />

        <!-- Opción 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#D1C4E9"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvModoOscuroClaro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notificaciones"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#311B92" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <!-- Opción 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#D1C4E9"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reacciones(Likes/Comentarios)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#311B92" />

            <androidx.appcompat.widget.SwitchCompat

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <!-- Opción 3 -->
        <!-- Agregar ID? android:id="@+id/tvModoOscuroClaro""-->
        <!-- Agregar ID? aandroid:id="@+id/switchTema"-->
        <!-- Agregar ID? android:id="@+id/btnPerfil"-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#D1C4E9"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mensaje Directos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#311B92" />

            <androidx.appcompat.widget.SwitchCompat

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

