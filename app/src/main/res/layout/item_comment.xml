<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Avatar del usuario -->
    <ImageView
        android:id="@+id/ivCommentAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/perro"
        android:contentDescription="Avatar"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <!-- Contenido del comentario -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nombre de usuario y tiempo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCommentUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@usuario"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvCommentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hace 2 horas"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Texto del comentario -->
        <TextView
            android:id="@+id/tvCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este es un comentario de ejemplo que puede ser muy largo y contener varias líneas de texto."
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivCommentLike"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/corazon"
                android:contentDescription="Like"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/tvCommentLikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/btnCommentReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responder"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/ivCommentMore"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="Más opciones"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>