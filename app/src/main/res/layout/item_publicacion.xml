<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. CABECERA (Perfil, Nombre, Fecha) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Foto de Perfil (Redonda) -->
            <androidx.cardview.widget.CardView
                android:layout_width="45dp"
                android:layout_height="45dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/img_perfil_usuario"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"/>
            </androidx.cardview.widget.CardView>

            <!-- Nombre y Fecha -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txt_fecha_publicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hace un momento"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Botón Más Opciones -->
            <ImageView
                android:id="@+id/btn_mas_opciones"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#757575"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 2. CUERPO (Texto y Foto) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Descripción Texto -->
            <TextView
                android:id="@+id/txt_contenido_publicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:text="Aquí va la descripción de lo que el usuario está compartiendo con su mascota..."
                android:textColor="#000000"
                android:textSize="15sp" />

            <!-- Foto Grande de la Publicación -->
            <ImageView
                android:id="@+id/img_publicacion"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#F5F5F5"
                android:visibility="gone" />
            <!-- visibility="gone" porque el adaptador la activará solo si existe foto -->
        </LinearLayout>

        <!-- Separador fino -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="8dp"/>

        <!-- 3. PIE (Barra de Acciones: Like, Comentar, Compartir) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botón Me Gusta -->
            <LinearLayout
                android:id="@+id/btn_me_gusta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/txt_contador_likes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Me gusta"
                    android:textColor="#666666"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Botón Comentar -->
            <LinearLayout
                android:id="@+id/btn_comentar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/stat_notify_chat"
                    app:tint="#666666"/>
                <TextView
                    android:id="@+id/txt_contador_comentarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Comentar"
                    android:textColor="#666666"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Botón Compartir -->
            <LinearLayout
                android:id="@+id/btn_compartir"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="#666666"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Compartir"
                    android:textColor="#666666"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>