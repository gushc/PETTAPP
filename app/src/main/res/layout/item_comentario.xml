<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- 🔴 CAMBIO AQUÍ: Usamos ImageView normal en vez de CircleImageView -->
    <androidx.cardview.widget.CardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/imgPerfilComentario"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0F2F5"
        android:padding="10dp">
        <!-- (El background puede ser un color gris claro directo para simplificar) -->

        <TextView
            android:id="@+id/txtNombreUsuarioComentario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Usuario"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtTextoComentario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comentario..."
            android:textColor="#333333"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtFechaComentario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reciente"
            android:textSize="10sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</LinearLayout>