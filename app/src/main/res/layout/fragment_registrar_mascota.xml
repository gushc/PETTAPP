<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Mascota.RegistrarMascotaFragment"
    android:background="@color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar Mascota"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/baseline_person_add_24"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="25dp"
                    android:backgroundTint="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="95dp"
                            android:layout_marginEnd="80dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtFotoRegistroMascota"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/imgFotoRegistroMascota"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_marginStart="95dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="80dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/custom_edittext"
                            android:contentDescription="Foto de la mascota"
                            android:scaleType="centerCrop">

                        </ImageView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtNombreMascota"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/regTxtNombreMascota"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="15dp"
                                android:background="@drawable/custom_edittext"
                                android:drawableTint="@color/c900"
                                android:ems="10"
                                android:hint="@string/rygTxtNombreMascota"
                                android:inputType="text"
                                android:padding="12dp"
                                android:textColor="@color/c950"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtEspecie"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/regTxtEspecie"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="15dp"
                                android:background="@drawable/custom_edittext"
                                android:drawableTint="@color/c900"
                                android:hint="@string/rygTxtEspecie"
                                android:inputType="text"
                                android:padding="12dp"
                                android:textColor="@color/c950"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtRaza"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/regTxtRaza"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="15dp"
                                android:background="@drawable/custom_edittext"
                                android:hint="@string/rygTxtRaza"
                                android:inputType="text"
                                android:padding="12dp"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtGeneroMascota"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spnSexoMascota"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="15dp"
                            android:background="@drawable/custom_edittext"
                            android:padding="12dp"
                            android:spinnerMode="dropdown" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtEdadMascota"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <EditText
                            android:id="@+id/regTxtEdadMascota"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="15dp"
                            android:background="@drawable/custom_edittext"
                            android:hint="@string/rygTxtEdadMascota"
                            android:padding="12dp"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtColorMascota"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:hintEnabled="false"> <!-- Desactiva la etiqueta flotante -->

                            <EditText
                                android:id="@+id/regTxtColorMascota"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="15dp"
                                android:background="@drawable/custom_edittext"
                                android:hint="@string/rygTxtColorMascota"
                                android:padding="12dp"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/TxtBoletinVacuna"
                            android:textColor="@color/colorbase"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false">

                            <EditText
                                android:id="@+id/regTxtBoletinVacuna"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginBottom="25dp"
                                android:background="@drawable/custom_edittext"
                                android:clickable="true"
                                android:drawableEnd="@drawable/adjuntar_img_icon"
                                android:focusable="false"
                                android:hint="@string/rygTxtBoletinVacuna"
                                android:inputType="none"
                                android:padding="12dp"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-10dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/regBtnSalirMascota"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginEnd="10dp"
                                android:layout_marginBottom="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/button_border"
                                android:drawableStart="@drawable/baseline_arrow_back_24"
                                android:text="@string/BtnSalir"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="18sp" />

                            <Button
                                android:id="@+id/regBtnRegistrarMascota"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/custom_button"
                                android:text="@string/BtnRegistrarMascota"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>